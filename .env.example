# Required. Host file containing only Grafana administrator password.
# Repository-relative example path is ignored by Git.
GRAFANA_ADMIN_PASSWORD_FILE=.secrets/grafana_admin_password.txt

# Required. Short deployment label attached to every exported metric.
HOST_ENV=

# Required. Absolute, writable host directory shared by commit hook and
# read-only collector mount. Installer protects sensitive state separately.
CC_METRICS_RUNTIME_DIR=

# Local-only default. Do not use a network-facing address without adding
# authentication, TLS, firewall policy, and privacy controls.
HOST_BIND_ADDRESS=127.0.0.1

# Host ports. Change when port is already used.
GRAFANA_PORT=33001
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_METRICS_PORT=8889

# Local metric retention. Prometheus duration syntax, for example 30d or 12w.
PROMETHEUS_RETENTION=30d

# Full image references. Review upstream release notes and digest changes.
GRAFANA_IMAGE=grafana/grafana:13.1.1@sha256:7cb8c64c4d57a57e734073f3cc94620adb24a0acb929bd80ba9f14017e3a975b
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1@sha256:3c42b892cf723fa54d2f262c37a0e1f80aa8c8ddb1da7b9b0df9455a35a7f893
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.157.0@sha256:f2f01157055a9b2aab9df7118e1f1c9abf345e99b23bc7a2bc791db374a7d0f6
